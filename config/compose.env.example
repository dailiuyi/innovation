# Copy to config/compose.env (gitignored), generate private random values, never commit it.
AR_DATABASE_PASSWORD=
AR_TOKEN_SECRET=
AR_BOOTSTRAP_PASSWORD=
# Positive bytes. This is an infrastructure test setting, not the future upload contract.
AR_STORAGE_MAX_BYTES=
# Set to the host's actual LAN address to allow LAN clients; default remains loopback.
AR_BIND_ADDRESS=127.0.0.1
AR_HTTP_PORT=18081
